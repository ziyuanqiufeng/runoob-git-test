  "heart_demon_tribulation": {
    "_comment": "大境界突破且心魔值≥threshold 时强制触发心魔劫幻境。每个 scenario 提供抉择，抉择永久改变性格标签(personality_tag)与后续事件概率(tribulation_effects)。",
    "threshold": 60,
    "scenarios": [
      {
        "id": "past_self",
        "name": "斩杀过去的软弱自己",
        "description": "幻境中，那个畏缩、仁慈、犹豫不决的「过去的你」站在面前，向你伸出手。",
        "choices": [
          {
            "id": "slay",
            "text": "挥剑斩之，断去软弱",
            "effects": {
              "heart_demon_delta": 15,
              "mental_state_delta": -5,
              "personality_tag": "cold",
              "subsequent_modifier": {"key": "kill_event_chance", "delta": 0.1}
            },
            "result_text": "你斩落过去的自己，眼底再无波澜。杀戮之心更盛，却也愈发冷酷。"
          },
          {
            "id": "forgive",
            "text": "拥抱过去的自己，与之和解",
            "effects": {
              "heart_demon_delta": -10,
              "mental_state_delta": 10,
              "personality_tag": "merciful",
              "subsequent_modifier": {"key": "save_life_event_chance", "delta": 0.1}
            },
            "result_text": "你与过去的自己相视一笑，心魔稍敛，道心渐明。"
          }
        ]
      },
      {
        "id": "beloved",
        "name": "放弃挚爱换取无上修为",
        "description": "幻境中，你的挚爱被锁在祭坛之上，以她为引可换一场通天造化。",
        "choices": [
          {
            "id": "sacrifice",
            "text": "推她入祭坛，夺取造化",
            "effects": {
              "heart_demon_delta": 22,
              "mental_state_delta": -8,
              "personality_tag": "ruthless_heart",
              "subsequent_modifier": {"key": "breakthrough_rate", "delta": -0.05}
            },
            "result_text": "祭坛光芒大作，你修为暴涨，却永远失去了某样东西。"
          },
          {
            "id": "protect",
            "text": "毁去祭坛，护她周全",
            "effects": {
              "heart_demon_delta": -12,
              "mental_state_delta": 15,
              "personality_tag": "loyal",
              "subsequent_modifier": {"key": "companion_buff", "delta": 0.1}
            },
            "result_text": "你掐灭祭坛，将她护在身后。道心通明，再无挂碍。"
          }
        ]
      },
      {
        "id": "heavenly_law",
        "name": "面对天道之质问",
        "description": "浩渺虚空中，一道无情的意志质问你：修行所为，可是逆天？",
        "choices": [
          {
            "id": "obey",
            "text": "俯首顺天，守本分",
            "effects": {
              "heart_demon_delta": -8,
              "mental_state_delta": 10,
              "personality_tag": "obedient",
              "subsequent_modifier": {"key": "tribulation_rate", "delta": -0.05}
            },
            "result_text": "你答天之道，心境澄澈，雷劫之威稍减。"
          },
          {
            "id": "defy",
            "text": "昂首逆天，夺造化",
            "effects": {
              "heart_demon_delta": 12,
              "mental_state_delta": -3,
              "personality_tag": "defiant",
              "subsequent_modifier": {"key": "tribulation_rate", "delta": 0.08}
            },
            "result_text": "你逆天而起，气势暴涨，却也引动更多天威。"
          }
        ]
